      "documentId": "doc-who-hypertension",
      "sourceId": "src-who",
      "section": "Blood pressure ranges",
      "content": "For most adults, a normal blood pressure reading is less than 120/80 mmHg. Blood pressure between 120/80 and 129/80 mmHg is often described as elevated."
    },
    {
      "id": "who-hypertension-2",
      "documentId": "doc-who-hypertension",
      "sourceId": "src-who",
      "section": "Definition",
      "content": "Hypertension is commonly defined as blood pressure of 130/80 mmHg or higher. Diagnosis requires repeated measurements and clinical assessment."
    },
    {
      "id": "aha-heart-rate-1",
      "documentId": "doc-aha-heart-rate",
      "sourceId": "src-aha",
      "section": "Resting heart rate",
      "content": "A normal resting heart rate for adults is usually between 60 and 100 beats per minute. Athletes may have a lower resting heart rate."
    },
    {
      "id": "cdc-exercise-1",
      "documentId": "doc-cdc-exercise",
      "sourceId": "src-cdc",
      "section": "Aerobic activity",
      "content": "Adults should aim for at least 150 minutes of moderate-intensity aerobic activity each week, along with muscle-strengthening activities on two or more days."
    },
    {
      "id": "acsm-exercise-1",
      "documentId": "doc-acsm-exercise",
      "sourceId": "src-acsm",
      "section": "Vigorous activity",
      "content": "Some guidelines suggest that 75 minutes of vigorous-intensity aerobic activity per week may be sufficient, although 150 minutes of moderate-intensity activity is commonly recommended."
    },
    {
      "id": "nih-sodium-1",
      "documentId": "doc-nih-sodium",
      "sourceId": "src-nih",
      "section": "Sodium limits",
      "content": "Most adults should limit sodium intake to no more than 2,300 mg per day. Some guidelines recommend 1,500 mg per day for people with hypertension. PMID: 34567890"
    },
