# ─── Database ─────────────────────────────────────────────
# PostgreSQL connection string
# Local:      postgresql://postgres:password@localhost:5432/medai
# Neon:       postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/medai?sslmode=require
# Railway:    postgresql://postgres:pass@containers-us-west-xxx.railway.app:5432/railway
DATABASE_URL=postgresql://postgres:password@localhost:5432/medai

# ─── Authentication ───────────────────────────────────────
# JWT signing secret — must be at least 32 random characters
# Generate: openssl rand -base64 32
SESSION_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# ─── AI (OpenAI) ──────────────────────────────────────────
# When running on Replit, these are auto-provisioned via Replit AI Integrations.
# When running elsewhere, use your own OpenAI API key:
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-api-key-here

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info
